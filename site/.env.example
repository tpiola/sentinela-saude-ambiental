# Copie para .env.local (nunca commite segredos).

# URL canônica do site (SEO / Open Graph / JSON-LD). Também usada como fallback
# quando NEXT_PUBLIC_GOOGLE_CALENDAR_URL não estiver definida.
NEXT_PUBLIC_SITE_URL=https://www.sentinelasaudeambiental.com.br

# Google Maps Embed API (opcional — sem chave usa embed público + link GPS)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_QUERY=Sentinela+Saúde+Ambiental+Franca+SP

# Vídeo do hero (MP4 HTTPS). Padrão em src/lib/brand.ts
# NEXT_PUBLIC_HERO_VIDEO_URL=https://seu-cdn.com/hero.mp4
# NEXT_PUBLIC_PROMO_VIDEO_URL=/media/sentinela/promo.mp4

# Google Calendar — URL pública de agendamento.
NEXT_PUBLIC_GOOGLE_CALENDAR_URL=

# Google Forms — opcionais.
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=
NEXT_PUBLIC_GOOGLE_CONTACT_FORM_OPEN_URL=

# n8n — segredo somente do servidor. Nunca use prefixo NEXT_PUBLIC_.
N8N_WEBHOOK_LEAD=https://seu-n8n.app/webhook/sentinela-lead

# Mensuração e mídia paga. Prefira GTM para centralizar as tags.
# Ex.: G-XXXXXXXXXX, GTM-XXXXXXX, AW-XXXXXXXXX e ID numérico do Pixel.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
