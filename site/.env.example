# URL canônica usada por SEO, Open Graph e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://www.sentinelasaudeambiental.com.br

# Google Maps opcional. Sem chave, o site usa o mapa público.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_QUERY=Sentinela+Saúde+Ambiental+Franca+SP

# Mensuração opcional. Deixe vazio enquanto as contas não existirem.
# O site não carregará scripts nem mostrará aviso de cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
