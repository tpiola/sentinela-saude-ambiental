# Copie para .env.local (nunca commite segredos).

# URL canónica do site (SEO / Open Graph / JSON-LD). Também usada como fallback
# quando NEXT_PUBLIC_GOOGLE_CALENDAR_URL não estiver definida (botões “Agendar agora”).
NEXT_PUBLIC_SITE_URL=https://www.sentinelasaudeambiental.com.br

# Google Maps Embed API (opcional — sem chave usa embed público + link GPS)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_QUERY=Sentinela+Saúde+Ambiental+Franca+SP

# Vídeo do hero (MP4 HTTPS). Padrão em src/lib/brand.ts
# NEXT_PUBLIC_HERO_VIDEO_URL=https://seu-cdn.com/hero.mp4
# Video promocional acima do hero (MP4 HTTPS ou caminho /public). Deixe vazio para ocultar a secao.
# NEXT_PUBLIC_PROMO_VIDEO_URL=/media/sentinela/promo.mp4

# Google Calendar — URL pública de agendamento (Appointment Schedule ou link compartilhável).
# Com valor, os CTAs “Agendar agora” abrem diretamente esta agenda.
NEXT_PUBLIC_GOOGLE_CALENDAR_URL=

# Leads Google Forms — crie um formulário ligado à planilha (ex.: destino de respostas
# 1Of8XoRPDIveGfBq7r6xpwd0cDUg6uVnSSniwazFc9K4). Use embed com ?embedded=true.
# Não utilize URL de edição da planilha como endpoint POST (não é API).
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=
# Opcional: página para abrir o mesmo formulário em nova aba quando não houver embed.
NEXT_PUBLIC_GOOGLE_CONTACT_FORM_OPEN_URL=

# n8n — webhooks para automação (WhatsApp, Meta, leads do site)
NEXT_PUBLIC_N8N_WEBHOOK_LEAD=https://seu-n8n.app/webhook/sentinela-lead
NEXT_PUBLIC_N8N_WEBHOOK_WHATSAPP=
NEXT_PUBLIC_N8N_WEBHOOK_META=

# Analytics (Google Search Console + GA4 + opcional GTM)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
