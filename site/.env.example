# Copie para .env.local e preencha (nunca commite segredos).
# Na Vercel: Project → Settings → Environment Variables (mesmos nomes, Production + Preview).
# Google Cloud Console: APIs Maps JavaScript / Embed / Places conforme necessário.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Consulta do lugar para o embed (nome do negócio ou endereço).
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_QUERY=Seu+Negócio+Cidade+UF
