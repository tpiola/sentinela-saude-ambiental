# Copie para .env.local (nunca commite segredos).

# URL canónica do site (SEO / Open Graph / JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.sentinelasaudeambiental.com.br

# Google Maps Embed — Cloud Console: Maps Embed API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Consulta para o iframe (negócio ou endereço).
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_QUERY=Sentinela+Saúde+Ambiental+Franca+SP

# Opcional: substituir vídeo do hero (MP4 HTTPS). Por defeito usa URL configurada em src/lib/brand.ts
# NEXT_PUBLIC_HERO_VIDEO_URL=
